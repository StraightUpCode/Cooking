{
  "name": "cooking-curriculum",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "The Kitchen Lab Manual — a bilingual (EN/ES) home-cooking curriculum, built with Vite + React + TypeScript and deployed on Cloudflare Workers Static Assets.",
  "scripts": {
    "content": "node scripts/migrate.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260828.1",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "node-html-parser": "^9.0.2",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "wrangler": "^4.0.0"
  }
}
